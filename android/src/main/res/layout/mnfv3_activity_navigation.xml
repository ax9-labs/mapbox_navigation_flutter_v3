<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mapbox.maps.MapView
        android:id="@+id/mnfv3_mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Turn arrow, instruction text, and distance-to-maneuver. Hidden
         until options.bannerInstructionsEnabled and a route is active. -->
    <com.mapbox.navigation.ui.components.maneuver.view.MapboxManeuverView
        android:id="@+id/mnfv3_maneuverView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- ETA / distance-remaining / time-remaining bar. Hidden until a
         route is active. -->
    <com.mapbox.navigation.ui.components.tripprogress.view.MapboxTripProgressView
        android:id="@+id/mnfv3_tripProgressView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Transient "Recalculating route..." indicator, shown only while
         RerouteState.FetchingRoute is active (the SDK's RerouteController
         reroutes automatically on its own - this is UI feedback for that,
         not the rerouting logic itself). -->
    <TextView
        android:id="@+id/mnfv3_rerouteView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="#CC000000"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="@string/mnfv3_recalculating_route"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
